{
  "name": "deco-hanini",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3005",
    "build": "next build",
    "start": "node server.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/run-prisma-migrate.mjs",
    "db:bootstrap-admin": "node scripts/bootstrap-admin.mjs",
    "db:export-catalog": "node scripts/export-catalog.mjs",
    "db:import-catalog": "node scripts/import-catalog.mjs",
    "seed:demo": "node -r ts-node/register prisma/seed_demo_catalog.ts",
    "deploy:build": "node scripts/validate-deployment-env.mjs && npm run db:generate && npm run db:migrate && npm run db:bootstrap-admin && npm run db:import-catalog -- --if-empty && next build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.24.0",
    "mysql2": "^3.23.0",
    "next": "16.2.10",
    "next-auth": "^5.0.0-beta.31",
    "prisma": "^5.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "sonner": "^2.0.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}
