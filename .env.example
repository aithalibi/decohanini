# MySQL database created in Hostinger hPanel.
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME"

# Generate with: openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"
NEXTAUTH_URL="https://www.example.com"

# This account is created or updated during the deployment build.
ADMIN_EMAIL="admin"
ADMIN_PASSWORD="REPLACE_WITH_A_STRONG_ADMIN_PASSWORD"

NEXT_PUBLIC_WHATSAPP_NUMBER="212777422673"

# Use an absolute writable directory outside the deployed application.
UPLOAD_DIR="/home/HOSTINGER_USER/domains/example.com/persistent-uploads"
NEXT_PUBLIC_UPLOAD_URL="/media"
